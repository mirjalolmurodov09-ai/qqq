<Window x:Class="AiUstozPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AiUstozPro.App.ViewModels"
        xmlns:v="clr-namespace:AiUstozPro.App.Views"
        Title="AI Ustoz Pro" Width="1320" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiAssistantViewModel}"><v:AiAssistantView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupsViewModel}"><v:GroupsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubjectsViewModel}"><v:SubjectsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarViewModel}"><v:CalendarView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimetableViewModel}"><v:TimetableView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LessonsViewModel}"><v:LessonsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CurriculumViewModel}"><v:CurriculumView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceViewModel}"><v:AttendanceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestsViewModel}"><v:TestsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LessonModeViewModel}"><v:LessonModeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}"><v:BackupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Chap menyu -->
        <DockPanel Background="{DynamicResource NavBg}">
            <StackPanel DockPanel.Dock="Top" Margin="22,22,16,18">
                <TextBlock Text="AI Ustoz Pro" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource NavSelectedFg}"/>
                <TextBlock Text="O'qituvchi yordamchisi · v0.1" FontSize="12" Foreground="{DynamicResource NavFg}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="22,10,16,18">
                <TextBlock Text="{Binding UserDisplay}" Foreground="{DynamicResource NavFg}" TextWrapping="Wrap" FontSize="12"/>
                <Button Content="Chiqish" Command="{Binding LogoutCommand}" Style="{StaticResource LinkButton}"
                        Foreground="{DynamicResource NavSelectedFg}" HorizontalAlignment="Left" Margin="-6,6,0,0"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Asosiy qism -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TodayText}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Command="{Binding ToggleThemeCommand}" ToolTip="Yorug' / qorong'i rejim" Margin="0" Padding="10,6">
                            <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="24,18,24,12" Focusable="False"/>

            <!-- Bildirishnoma -->
            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,22" Padding="14,10" CornerRadius="6"
                    MaxWidth="460" Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
