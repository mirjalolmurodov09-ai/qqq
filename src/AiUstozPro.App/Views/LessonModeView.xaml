<UserControl x:Class="AiUstozPro.App.Views.LessonModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Sana" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding Date}"/>
                    <TextBlock Text="Darslar" Style="{StaticResource SectionTitle}" Margin="0,14,0,6"/>
                    <TextBlock Text="Bu kunda darsingiz yo'q." Style="{StaticResource Hint}"
                               Visibility="{Binding DayLessons.Count, Converter={StaticResource ZeroToVis}}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding DayLessons}" SelectedItem="{Binding SelectedLesson}" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextPrimary}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,6">
                                <TextBlock Text="{Binding Time}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Header}"/>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" IsEnabled="{Binding HasLesson}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Ekranda ko'rsatish (proyektor)" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPresentationCommand}" Margin="0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding TopicTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0"/>
                        <TextBlock Text="{Binding LessonHeader}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding AttendanceText}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </DockPanel>
                <TabControl Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
                    <TabItem Header="Mavzu va materiallar">
                        <DockPanel Margin="4,10,4,4">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding TopicDetails}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button Content="Mavzuni ekranda ko'rsatish" Command="{Binding ShowTopicCommand}"/>
                                <Button Content="Mavzu o'tildi" Command="{Binding CompleteTopicCommand}" IsEnabled="{Binding CanEdit}"/>
                                <Button Content="Davomat olish" Command="{Binding GoAttendanceCommand}"/>
                            </WrapPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="+ Fayl" Command="{Binding AddFileCommand}"/>
                                    <Button Content="+ Havola" Command="{Binding AddLinkCommand}"/>
                                    <Button Content="Olib tashlash" Style="{StaticResource DangerButton}" Command="{Binding DeleteMaterialCommand}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="Materiallar (taqdimot, PDF, video, havola)" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" IsReadOnly="True">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenMaterialCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nomi" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Turi" Binding="{Binding Kind}" Width="80"/>
                                    <DataGridTextColumn Header="Joylashuvi" Binding="{Binding Location}" Width="2*"/>
                                    <DataGridTemplateColumn Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ochish" Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.OpenMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Taymer">
                        <StackPanel Margin="4,16" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TimerText}" FontSize="72" FontWeight="SemiBold" FontFamily="Consolas">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TimerFinished}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="3 daq" Command="{Binding SetMinutesCommand}" CommandParameter="3"/>
                                <Button Content="5 daq" Command="{Binding SetMinutesCommand}" CommandParameter="5"/>
                                <Button Content="10 daq" Command="{Binding SetMinutesCommand}" CommandParameter="10"/>
                                <Button Content="15 daq" Command="{Binding SetMinutesCommand}" CommandParameter="15"/>
                                <Button Content="20 daq" Command="{Binding SetMinutesCommand}" CommandParameter="20"/>
                                <TextBox Text="{Binding TimerMinutes, UpdateSourceTrigger=PropertyChanged}" Width="60" ToolTip="Daqiqa"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Boshlash" Style="{StaticResource PrimaryButton}" Command="{Binding StartTimerCommand}"/>
                                <Button Content="Pauza" Command="{Binding PauseTimerCommand}"/>
                                <Button Content="Qaytadan" Command="{Binding ResetTimerCommand}"/>
                                <Button Content="Ekranda ko'rsatish" Command="{Binding ShowTimerCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Vaqt tugaganda ovozli signal beriladi va raqamlar qizil rangga o'tadi."/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Topshiriq">
                        <DockPanel Margin="4,10,4,4">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button Content="Topshiriqni ekranda ko'rsatish" Style="{StaticResource PrimaryButton}" Command="{Binding ShowTaskCommand}"/>
                                <Button Content="Taymer bilan (ekranga taymer)" Command="{Binding ShowTimerCommand}"/>
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Topshiriq matnini yozing yoki AI yordamchidan (Amaliy topshiriqlar) nusxa olib qo'ying, so'ng sinfga katta ekranda ko'rsating."/>
                            <TextBox Text="{Binding TaskText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="15"/>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Tezkor so'rov">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,10" MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="Savolni ekranga chiqaring, o'quvchilar qo'l ko'taradi — har bir variant uchun &quot;+&quot; bilan sanang, so'ng natijani ko'rsating. Shaxsiy baho qo'yilmaydi."/>
                                <TextBlock Text="Savol" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding PollQuestion, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding PollOptions}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Letter}" Width="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <CheckBox Content="to'g'ri" IsChecked="{Binding IsCorrect}" VerticalAlignment="Center"/>
                                                    <Button Content="−" Width="34" Command="{Binding DataContext.UnvoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding Count}" Width="34" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                    <Button Content="+" Width="34" Margin="0" Command="{Binding DataContext.VoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Savolni ekranda ko'rsatish" Style="{StaticResource PrimaryButton}" Command="{Binding ShowPollCommand}"/>
                                    <CheckBox Content="Natijani ekranda ko'rsatish" IsChecked="{Binding ShowPollResults}" VerticalAlignment="Center"/>
                                    <Button Content="Jurnalga yozish" Command="{Binding SavePollCommand}"/>
                                    <Button Content="Tozalash" Command="{Binding ResetPollCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Jurnal va dars yakuni">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,10" MaxWidth="900" HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding MicNotesCommand}" Margin="0" ToolTip="Ovoz bilan yozish"
                                            Visibility="{Binding VoiceEnabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE720; Gapirish" FontFamily="Segoe MDL2 Assets, Segoe UI"/>
                                    </Button>
                                    <TextBlock Text="Darsda nima bo'ldi (o'qituvchi izohi)" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                                </DockPanel>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top"/>
                                <TextBlock Text="{Binding Voice.Status}" Style="{StaticResource Hint}" Visibility="{Binding Voice.Status, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="Uyga vazifa" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Homework, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalContentAlignment="Top"/>
                                <DockPanel Margin="0,8,0,3">
                                    <Button DockPanel.Dock="Right" Content="AI bilan xulosa tayyorlash" Command="{Binding AiSummaryCommand}" Margin="0"/>
                                    <TextBlock Text="Dars yakuni xulosasi" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="0"/>
                                </DockPanel>
                                <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalContentAlignment="Top"/>
                                <TextBlock Text="AI xulosa tayyorlamoqda…" Style="{StaticResource Hint}" Visibility="{Binding AiBusy, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Tezkor so'rov natijalari" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding PollResults, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalContentAlignment="Top"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Saqlash" Style="{StaticResource PrimaryButton}" Command="{Binding SaveLogCommand}"/>
                                    <Button Content="Dars o'tildi" Command="{Binding MarkConductedCommand}"/>
                                    <Button Content="Dars hisoboti (Word/PDF)" Command="{Binding ExportReportCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
