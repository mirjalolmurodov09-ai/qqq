<UserControl x:Class="AiUstozPro.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Foydalanuvchilar" Style="{StaticResource SectionTitle}"/>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="Parolni tiklash" Command="{Binding ResetPasswordCommand}"/>
                    <Button Content="Bloklash / blokdan chiqarish" Style="{StaticResource DangerButton}" Command="{Binding ToggleBlockCommand}"/>
                </WrapPanel>
                <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding IsObserverSelected, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                    <TextBlock Text="Kuzatuvchiga ruxsat berilgan guruhlar" Style="{StaticResource Label}"/>
                    <ItemsControl ItemsSource="{Binding GroupChecks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Group.Name}" IsChecked="{Binding IsChecked}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Guruhlarni saqlash" Command="{Binding SaveGroupsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="130"/>
                        <DataGridTextColumn Header="F.I.Sh." Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="150"/>
                        <DataGridTextColumn Header="Holat" Binding="{Binding State}" Width="150"/>
                        <DataGridTextColumn Header="Oxirgi kirish" Binding="{Binding LastLogin}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Yangi foydalanuvchi" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Login (lotin harflari)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding NewLogin, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="F.I.Sh." Style="{StaticResource Label}"/>
                <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Rol" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}"/>
                <Button Content="Yaratish" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                           Text="Administrator — hamma narsa. O'qituvchi — guruhlar, jadval, KTR, davomat va hisobotlar (faqat o'z darslarida davomat). Kuzatuvchi — faqat ruxsat berilgan guruhlar hisobotlarini ko'radi."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
