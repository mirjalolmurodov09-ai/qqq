<UserControl x:Class="AiUstozPro.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Guruhlar -->
        <Border Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Guruhlar" Style="{StaticResource SectionTitle}"/>
                <StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="Guruh nomi" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Kurs (ixtiyoriy)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding GroupCourse, UpdateSourceTrigger=PropertyChanged}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Saqlash" Style="{StaticResource PrimaryButton}" Command="{Binding SaveGroupCommand}"/>
                        <Button Content="Yangi" Command="{Binding NewGroupCommand}"/>
                        <Button Content="Arxiv" Command="{Binding ArchiveGroupCommand}" Margin="0" ToolTip="Arxivlash / arxivdan chiqarish"/>
                    </WrapPanel>
                </StackPanel>
                <CheckBox DockPanel.Dock="Bottom" Content="Arxivdagi guruhlarni ko'rsatish" IsChecked="{Binding ShowArchivedGroups}" Margin="0,8,0,4"/>
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextPrimary}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Course}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- O'quvchilar ro'yxati -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Import (Excel/CSV)" Command="{Binding ImportStudentsCommand}" IsEnabled="{Binding CanEdit}"/>
                        <Button Content="Eksport" Command="{Binding ExportStudentsCommand}"/>
                        <Button Content="Davomat tarixi" Command="{Binding ExportStudentHistoryCommand}" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="O'quvchilar" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <CheckBox DockPanel.Dock="Right" Content="Arxivdagilarni ham" IsChecked="{Binding ShowInactive}" Margin="12,0,0,0"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="F.I.Sh. yoki raqam bo'yicha qidirish"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="{Binding StudentsCountText}"/>
                <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Familiya" Binding="{Binding LastName}" Width="*"/>
                        <DataGridTextColumn Header="Ism" Binding="{Binding FirstName}" Width="*"/>
                        <DataGridTextColumn Header="Otasining ismi" Binding="{Binding MiddleName}" Width="*"/>
                        <DataGridTextColumn Header="Raqami" Binding="{Binding StudentNumber}" Width="110"/>
                        <DataGridCheckBoxColumn Header="Faol" Binding="{Binding IsActive}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- O'quvchi formasi -->
        <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top" IsEnabled="{Binding CanEdit}">
            <StackPanel>
                <TextBlock Text="{Binding StudentFormTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Familiya *" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Ism *" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Otasining ismi" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="O'quvchi raqami (noyob)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding StudentNumber, UpdateSourceTrigger=PropertyChanged}"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Saqlash" Style="{StaticResource PrimaryButton}" Command="{Binding SaveStudentCommand}"/>
                    <Button Content="Yangi" Command="{Binding NewStudentCommand}"/>
                </WrapPanel>
                <Button Content="Arxivlash / faollashtirish" Command="{Binding ToggleStudentActiveCommand}" Style="{StaticResource DangerButton}"
                        Margin="0,10,0,0" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                           Text="O'quvchi o'chirilmaydi — arxivlanadi, shunda davomat tarixi saqlanib qoladi. Yuz orqali davomat uchun rasm va rozilik keyingi versiyada qo'shiladi."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
