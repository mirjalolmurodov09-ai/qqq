<UserControl x:Class="AiUstozPro.App.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Suhbatlar -->
        <Border Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="+ Yangi so'rov" Style="{StaticResource PrimaryButton}" Command="{Binding NewConversationCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                <Button DockPanel.Dock="Bottom" Content="Suhbatni o'chirish" Style="{StaticResource DangerButton}" Command="{Binding DeleteConversationCommand}"
                        HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                <TextBlock DockPanel.Dock="Top" Text="Suhbatlar tarixi" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextPrimary}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,5">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UpdatedUtc, StringFormat='dd.MM.yyyy HH:mm'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource InfoBanner}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="So'rov yuborilmoqda…" FontWeight="SemiBold"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="12,0,0,0"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding VoiceEnabled, Converter={StaticResource BoolToVis}}">
                        <Button Content="Ovozni to'xtatish" Style="{StaticResource LinkButton}" Command="{Binding StopSpeakingCommand}"/>
                        <Button Content="Qayta eshittirish" Style="{StaticResource LinkButton}" Command="{Binding ReplayCommand}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Voice.Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Visibility="{Binding Voice.Status, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Yangi so'rov formasi -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding ShowNewForm, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Yangi so'rov" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Topshiriq" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" DisplayMemberPath="Title"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Guruh va fan (KTR dan mavzu olish uchun)" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Pairs}" SelectedItem="{Binding Pair}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TemplateHint}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>

                    <Grid Visibility="{Binding NeedsTopic, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="KTR mavzusi" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Topics}" SelectedItem="{Binding Topic}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mavzu (tahrirlash mumkin)" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding TopicText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Murakkablik" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Soni" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,8,0,3">
                        <Button DockPanel.Dock="Right" Content="Davomat ma'lumotini qo'shish (anonim)" Command="{Binding InsertAttendanceCommand}" Margin="0"
                                Visibility="{Binding IsAnalytics, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="Qo'shimcha matn: savol, kod, eslatma yoki ma'lumot" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Bottom"/>
                    </DockPanel>
                    <TextBox Text="{Binding Extra, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             Height="110" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas"/>
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding MicExtraCommand}" ToolTip="Ovoz bilan kiritish (bosing — gapiring — yana bosing)"
                                    Visibility="{Binding VoiceEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE720; Gapirish" FontFamily="Segoe MDL2 Assets, Segoe UI"/>
                            </Button>
                            <Button Content="To'xtatish" Command="{Binding SendCancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Yuborish" Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   Text="O'quvchilarning ism-familiyasini yubormang. Davomat tahlili ismlarsiz (O'quvchi 1, 2 …) yuboriladi."/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Xabarlar -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Visibility="{Binding ShowNewForm, Converter={StaticResource InvBoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{Binding Who}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" Padding="0"
                                                 VerticalContentAlignment="Top" MinHeight="0"/>
                                        <DockPanel Margin="0,6,0,0" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="O'qib berish" Style="{StaticResource LinkButton}"
                                                        Visibility="{Binding DataContext.VoiceEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.SpeakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Content="Nusxa olish" Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Content="Tekshirish va tasdiqlash" Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Content="Word'ga saqlash" Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.SaveWordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReviewText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Davom etish -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding ShowNewForm, Converter={StaticResource InvBoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <Button Command="{Binding MicFollowUpCommand}" ToolTip="Ovoz bilan kiritish"
                                Visibility="{Binding VoiceEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <Button Content="To'xtatish" Command="{Binding SendFollowUpCancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Yuborish" Style="{StaticResource PrimaryButton}" Command="{Binding SendFollowUpCommand}" Margin="0"/>
                    </StackPanel>
                    <TextBox Text="{Binding FollowUp, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" ToolTip="Shu suhbat davomida aniqlashtiruvchi savol"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
