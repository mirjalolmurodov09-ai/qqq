<UserControl x:Class="AiUstozPro.App.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Sana" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding Date}"/>
                    <TextBlock Text="Darslar" Style="{StaticResource SectionTitle}" Margin="0,14,0,6"/>
                    <TextBlock Text="Bu kunda sizning darsingiz yo'q." Style="{StaticResource Hint}"
                               Visibility="{Binding DayLessons.Count, Converter={StaticResource ZeroToVis}}"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource InfoBanner}" Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="Yuz orqali davomat (veb-kamera) keyingi versiyada qo'shiladi: u faqat ota-ona roziligi bilan, lokal kompyuterda ishlaydi va natijani o'qituvchi tasdiqlaydi. Hozircha davomat qo'lda olinadi."/>
                </Border>
                <ListBox ItemsSource="{Binding DayLessons}" SelectedItem="{Binding SelectedLesson}" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextPrimary}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,6">
                                <TextBlock Text="{Binding Time}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Header}"/>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding LessonTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LessonTopic}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding HasLesson, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanEdit}">
                        <Button Content="Belgilanmaganlarni &quot;Keldi&quot;" Command="{Binding AllPresentCommand}"/>
                        <Button Content="Bekor qilish" Command="{Binding ReloadCommand}"/>
                        <Button Content="Saqlash" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Stats}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Rows}" CanUserSortColumns="False"
                          Visibility="{Binding HasLesson, Converter={StaticResource BoolToVis}}" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding No}" Width="40" IsReadOnly="True"/>
                        <DataGridTextColumn Header="F.I.Sh." Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Raqami" Binding="{Binding Number}" Width="90" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Holat" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Statuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" MinHeight="26" Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Izoh" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"
                                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
