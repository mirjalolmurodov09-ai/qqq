<UserControl x:Class="AiUstozPro.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Zaxira nusxalar" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                           Text="Dastur har kuni birinchi ishga tushganda avtomatik zaxira nusxa oladi (oxirgi 14 tasi saqlanadi). Muhim o'zgarishlardan oldin qo'lda nusxa oling va vaqti-vaqti bilan nusxani fleshka yoki boshqa diskka saqlang."/>
                <TextBlock Text="{Binding Folder, StringFormat='Papka: {0}'}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="Zaxira nusxa olish" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}"/>
                    <Button Content="Boshqa joyga saqlash…" Command="{Binding SaveCopyCommand}"/>
                    <Button Content="Papkani ochish" Command="{Binding OpenFolderCommand}"/>
                    <Button Content="Tiklash…" Style="{StaticResource DangerButton}" Command="{Binding RestoreCommand}"/>
                </WrapPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vaqt (UTC)" Binding="{Binding CreatedUtc, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                    <DataGridTextColumn Header="Turi" Binding="{Binding Kind}" Width="120"/>
                    <DataGridTextColumn Header="Kim" Binding="{Binding CreatedBy}" Width="100"/>
                    <DataGridTextColumn Header="Hajmi (bayt)" Binding="{Binding SizeBytes}" Width="110"/>
                    <DataGridTextColumn Header="Fayl" Binding="{Binding FilePath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
