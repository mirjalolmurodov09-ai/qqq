<Window x:Class="AiUstozPro.App.Views.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Ustoz Pro — ekran (proyektor)" Width="1100" Height="700"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding TopicTitle}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <!-- Mavzu -->
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Left"
                 Visibility="{Binding IsTopicMode, Converter={StaticResource BoolToVis}}" Margin="0,24,0,0">
            <TextBlock Text="{Binding TopicDetails}" FontSize="30" TextWrapping="Wrap" MaxWidth="1600"/>
        </Viewbox>

        <!-- Taymer -->
        <Viewbox Grid.Row="1" Visibility="{Binding IsTimerMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding TimerText}" FontWeight="SemiBold" FontFamily="Consolas">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TimerFinished}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Viewbox>

        <!-- Topshiriq -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,0"
                      Visibility="{Binding IsTaskMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding TaskText}" FontSize="34" TextWrapping="Wrap"/>
        </ScrollViewer>

        <!-- Tezkor so'rov -->
        <StackPanel Grid.Row="1" Margin="0,24,0,0" Visibility="{Binding IsPollMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding PollQuestion}" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,24"/>
            <ItemsControl ItemsSource="{Binding PollOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8" Visibility="{Binding Text, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="30" TextWrapping="Wrap">
                                <Run Text="{Binding Letter, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=") "/><Run Text="{Binding Text, Mode=OneWay}"/>
                            </TextBlock>
                            <Grid Grid.Column="1" Visibility="{Binding DataContext.ShowPollResults, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource GridHeaderBg}" CornerRadius="6" Height="40"/>
                                <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="40" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="{Binding Count}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding LessonHeader}" FontSize="16" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
    </Grid>
</Window>
